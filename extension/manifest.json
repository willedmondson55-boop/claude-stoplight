{
  "manifest_version": 3,
  "name": "Claude Code Stoplight",
  "version": "1.0.0",
  "description": "At-a-glance stoplight for your Claude Code session: green = working, yellow = needs you, red = done, grey = no session.",
  "permissions": ["storage", "notifications", "offscreen", "alarms"],
  "host_permissions": ["http://127.0.0.1:4747/*"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude Code Stoplight",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["overlay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
