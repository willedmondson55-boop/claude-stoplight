{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" green 'session started'",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" green 'working on your prompt'",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" green 'running tools'",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" green 'running tools'",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" yellow 'waiting for you'",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" red 'finished responding'",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/claude-stoplight/hooks/report-state.sh\" grey 'session ended'",
            "async": true
          }
        ]
      }
    ]
  }
}
